# ==============================================================================
# HQMS - Smart Hospital Virtual Queue Platform Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="HQMS - Smart Hospital Virtual Queue"
API_V1_STR="/api/v1"
DEBUG=true

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-insecure-secret-key-to-a-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hqms_admin
POSTGRES_PASSWORD=hqms_secure_password
POSTGRES_DB=hqms_db
# Async connection URL format: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=postgresql+asyncpg://hqms_admin:hqms_secure_password@localhost:5432/hqms_db

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Queue Engine Settings
DEFAULT_CONSULTATION_TIME_MINUTES=10
DEFAULT_REJOIN_OFFSET=2
DEFAULT_AWAY_TIMEOUT_MINUTES=30
ETA_CONFIDENCE_INTERVAL_PERCENTAGE=20

# CORS Origins (comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Notification Gateway (mock | twilio | gupshup)
NOTIFICATION_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
